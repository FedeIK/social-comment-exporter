{
  "manifest_version": 3,
  "name": "Social Comment Exporter",
  "version": "1.0.0",
  "description": "Recopila y exporta comentarios de Facebook, Instagram y Twitter (X).",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Abrir Exporter"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*"
      ],
      "js": [
        "extractors/base-extractor.js",
        "extractors/facebook-adapter.js",
        "extractors/instagram-adapter.js",
        "extractors/twitter-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}